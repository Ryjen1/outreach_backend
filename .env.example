# --- Local development (MySQL) ---
# SECRET_KEY=local-dev-secret-key-not-for-production
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# DB_ENGINE=mysql
# DB_NAME=outreach
# DB_USER=outreach
# DB_PASSWORD=outreachpw
# DB_HOST=127.0.0.1
# DB_PORT=3306
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- Apollo.io API ---
# Get your API key from https://app.apollo.io/#/settings/integrations/api
# APOLLO_API_KEY=your-apollo-api-key-here

# --- Apify API (pay-as-you-go — https://console.apify.com/) ---
# Get your token from https://console.apify.com/account/integrations
# APIFY_API_TOKEN=your-apify-api-token-here

# --- Render deployment (SQLite demo) ---
# SECRET_KEY=change-me-to-a-random-string
# DEBUG=False
# ALLOWED_HOSTS=your-backend.onrender.com
# DB_ENGINE=sqlite
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
